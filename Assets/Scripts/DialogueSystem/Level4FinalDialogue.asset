  m_Script: {fileID: 11500000, guid: 51da424e7686a61468ec652898dfc714, type: 3}
  m_Name: Level4FinalDialogue
  m_EditorClassIdentifier: Assembly-CSharp::DialogueSequence
  lines:
  - speaker: 1
    dialogue: Don't go. They'll all se you fail
    duration: 5
  - speaker: 0
    dialogue: Wait. All these words you're saying are my words. I thought about them
      before.
    duration: 7
  - speaker: 1
    dialogue: Stop. Don't say it.
    duration: 5
  - speaker: 0
    dialogue: You were never someone else. The one who held me back... was me.
    duration: 5
  - speaker: 0
    dialogue: All this time, I was standing In My Own Way
    duration: 5
