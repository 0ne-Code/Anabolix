  m_Script: {fileID: 11500000, guid: 51da424e7686a61468ec652898dfc714, type: 3}
  m_Name: Level1Opening
  m_EditorClassIdentifier: Assembly-CSharp::DialogueSequence
  lines:
  - speaker: 0
    dialogue: Where am I? Why can't I remember anything?
    duration: 5
  - speaker: 1
    dialogue: Stay down. You will only fail again.
    duration: 5
  - speaker: 0
    dialogue: Who's there? Why am i so scared to move?
    duration: 5
  - speaker: 1
    dialogue: Everyone is ahead of you. You're too late.
    duration: 5
  - speaker: 0
    dialogue: I can't do this, i don't even know what "this" is.
    duration: 5
  - speaker: 1
    dialogue: Good. Keep saying it. You are so good at it.
    duration: 5
